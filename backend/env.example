# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Security (REQUIRED in production)
JWT_SECRET=your-super-secure-jwt-secret-key-here
REDIS_URL=redis://localhost:6379

# Plugin Configuration
PLUGIN_KEY=your-plugin-key-here

# Sepay Payment Gateway (REQUIRED for payments)
SEPAY_API_KEY=your-sepay-api-key
SEPAY_ACCOUNT_NO=your-account-number
SEPAY_BANK_CODE=Mbbank
SEPAY_QR_TEMPLATE=compact
SEPAY_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
SEPAY_RETURN_URL=https://yourdomain.com/payment/success
SEPAY_CALLBACK_URL=https://yourdomain.com/api/payments/callback
SEPAY_WEBHOOK_TOKEN=your-webhook-token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/oauth/facebook/callback

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/oauth/discord/callback

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m

# Auto-restart
MAX_RESTART_ATTEMPTS=5
RESTART_DELAY=5000
MAX_RESTART_DELAY=60000
HEALTH_CHECK_INTERVAL=30000
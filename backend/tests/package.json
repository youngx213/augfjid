{
  "name": "tiktok-bot-backend-tests",
  "version": "1.0.0",
  "description": "Test suite for TikTok Bot Backend",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "vitest": "^1.0.0",
    "supertest": "^6.3.3",
    "@vitest/ui": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "jsdom": "^23.0.0"
  },
  "vitest": {
    "environment": "node",
    "testTimeout": 10000,
    "coverage": {
      "provider": "v8",
      "reporter": ["text", "json", "html"],
      "exclude": [
        "node_modules/",
        "tests/",
        "coverage/",
        "*.config.js"
      ]
    }
  }
}
